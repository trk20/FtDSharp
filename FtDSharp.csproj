<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">/home/trk20/From The Depths/Mods/FtDSharp</ModDeployDir>
  </PropertyGroup>

  <!-- Exclude the CodeGen project folder and decompile reference from compilation -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);FtDSharp_Reference\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FtDSharp.API\**" />
    <Compile Remove="FtDSharp.CodeGen\**" />
    <None Remove="FtDSharp.CodeGen\**" />
    <Compile Remove="FtD_Reference\**" />
    <None Remove="FtD_Reference\**" />
    <Compile Remove="dist\**" />
    <None Remove="dist\**" />
    <Compile Remove="ScriptProject\**" />
    <None Remove="ScriptProject\**" />
    <Compile Remove="ExampleScripts\**" />
    <None Remove="ExampleScripts\**" />
    <Compile Remove="FtDSharp.Tests\**" />
    <None Remove="FtDSharp.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FtDSharp.API\FtDSharp.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Ftd">
      <HintPath>ftd-managed\Ftd.dll</HintPath>
    </Reference>
    <Reference Include="Modding">
      <HintPath>ftd-managed\Modding.dll</HintPath>
    </Reference>
    <Reference Include="Effects">
      <HintPath>ftd-managed\Effects.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>ftd-managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="GridCasts">
      <HintPath>ftd-managed\GridCasts.dll</HintPath>
    </Reference>
    <Reference Include="Core">
      <HintPath>ftd-managed\Core.dll</HintPath>
    </Reference>
    <Reference Include="Common">
      <HintPath>ftd-managed\Common.dll</HintPath>
    </Reference>
    <Reference Include="FtdLua">
      <HintPath>ftd-managed\FtdLua.dll</HintPath>
    </Reference>
    <Reference Include="Ui">
      <HintPath>ftd-managed\Ui.dll</HintPath>
    </Reference>
    <Reference Include="Ai">
      <HintPath>ftd-managed\Ai.dll</HintPath>
    </Reference>
    <Reference Include="DataManagement">
      <HintPath>ftd-managed\DataManagement.dll</HintPath>
    </Reference>
    <Reference Include="Breadboards">
      <HintPath>ftd-managed\Breadboards.dll</HintPath>
    </Reference>
    <Reference Include="Profiling">
      <HintPath>ftd-managed\Profiling.dll</HintPath>
    </Reference>
    <Reference Include="Localisation">
      <HintPath>ftd-managed\Localisation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.12.0-beta1.25218.8" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(ModDeployDir)" />
    <ItemGroup>
      <_DeployBuildDlls Include="$(OutputPath)FtDSharp.dll" />
      <_DeployBuildDlls Include="$(OutputPath)FtDSharp.API.dll" />
      <_DeployBuildDlls Include="$(OutputPath)Microsoft.CodeAnalysis.dll" />
      <_DeployBuildDlls Include="$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Collections.Immutable.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Reflection.Metadata.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Text.Encoding.CodePages.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Memory.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <_DeployBuildDlls Include="$(OutputPath)System.Threading.Tasks.Extensions.dll" />
      <_DeployRootFiles Include="$(ProjectDir)plugin.json" />
      <_DeployRootFiles Include="$(ProjectDir)header.header" />
      <_DeployRootFiles Include="$(ProjectDir)0Harmony.dll" />
      <_DeployTipOfTheDay Include="$(ProjectDir)TipOfTheDay\**\*" />
      <_DeployExampleScripts Include="$(ProjectDir)ExampleScripts\**\*" Exclude="$(ProjectDir)ExampleScripts\bin\**\*;$(ProjectDir)ExampleScripts\obj\**\*" />
      <_DeployScriptProject Include="$(ProjectDir)ScriptProject\**\*" Exclude="$(ProjectDir)ScriptProject\bin\**\*;$(ProjectDir)ScriptProject\obj\**\*" />
      <_DeployReferences Include="$(ProjectDir)References\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployBuildDlls)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll" DestinationFolder="$(ModDeployDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll" DestinationFolder="$(ModDeployDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployRootFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployTipOfTheDay)" DestinationFiles="@(_DeployTipOfTheDay->'$(ModDeployDir)\TipOfTheDay\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_DeployTipOfTheDay)' != ''" />
    <Copy SourceFiles="@(_DeployExampleScripts)" DestinationFiles="@(_DeployExampleScripts->'$(ModDeployDir)\ExampleScripts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_DeployExampleScripts)' != ''" />
    <Copy SourceFiles="@(_DeployScriptProject)" DestinationFiles="@(_DeployScriptProject->'$(ModDeployDir)\ScriptProject\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_DeployScriptProject)' != ''" />
    <Copy SourceFiles="@(_DeployReferences)" DestinationFiles="@(_DeployReferences->'$(ModDeployDir)\References\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_DeployReferences)' != ''" />
  </Target>

</Project>
